Example

Input: 1 2 3 4 5 6
Output: Even = 3, Odd = 3

---------------------------------------------------------------------------------------------

def countEvenOdd(nums):
    even = 0
    odd = 0

    for num in nums:
        if num % 2 == 0:
            even += 1
        else:
            odd += 1

    return even, odd


# ===== MAIN PROGRAM =====
nums = list(map(int, input("Enter numbers: ").split()))

even, odd = countEvenOdd(nums)

print("Even numbers:", even)
print("Odd numbers:", odd)
