Input: 1 3 5 7 9
Output: 5

---------------------------------------------------------------------------------------------------------

def findMedian(nums):
    nums.sort()
    n = len(nums)

    if n % 2 == 1:
        return nums[n // 2]
    else:
        return (nums[n // 2 - 1] + nums[n // 2]) / 2


# ===== MAIN PROGRAM =====
nums = list(map(int, input("Enter numbers: ").split()))

print("Median:", findMedian(nums))
