Problem:
Return True if any value appears at least twice.

Example:
Input: [1,2,3,1]
Output: True

----------------------------------------------------------------------------------------------------------------------------

def containsDuplicate(nums):
    return len(nums) != len(set(nums))


# ===== MAIN PROGRAM =====
nums = list(map(int, input("Enter numbers: ").split()))

if containsDuplicate(nums):
    print("Contains Duplicate")
else:
    print("No Duplicates")
