def findAverage(nums):
    if len(nums) == 0:
        return 0
    return sum(nums) / len(nums)


# ===== MAIN PROGRAM =====
nums = list(map(int, input("Enter numbers: ").split()))

avg = findAverage(nums)

print("Average:", avg)
