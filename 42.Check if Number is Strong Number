(A Strong number = sum of factorial of digits equals the number)

Example: 145 → 1! + 4! + 5! = 145

---------------------------------------------------------------------------------------------------------------------------------------

def factorial(n):
    result = 1
    for i in range(1, n + 1):
        result *= i
    return result

def isStrong(num):
    temp = num
    total = 0

    while temp > 0:
        digit = temp % 10
        total += factorial(digit)
        temp //= 10

    return total == num


# ===== MAIN PROGRAM =====
num = int(input("Enter a number: "))

if isStrong(num):
    print("Strong Number")
else:
    print("Not a Strong Number")
