class Stack:
    def __init__(self):
        self.stack = []

    def push(self, value):
        self.stack.append(value)

    def pop(self):
        if not self.isEmpty():
            return self.stack.pop()
        return "Stack is empty"

    def peek(self):
        if not self.isEmpty():
            return self.stack[-1]
        return "Stack is empty"

    def isEmpty(self):
        return len(self.stack) == 0


# ===== MAIN PROGRAM =====
s = Stack()

while True:
    print("\n1. Push")
    print("2. Pop")
    print("3. Peek")
    print("4. Exit")

    choice = int(input("Enter choice: "))

    if choice == 1:
        value = int(input("Enter value: "))
        s.push(value)
    elif choice == 2:
        print("Popped:", s.pop())
    elif choice == 3:
        print("Top element:", s.peek())
    elif choice == 4:
        break
    else:
        print("Invalid choice")
