Example

Input: 5
Output: 1 3 5 7 9

----------------------------------------------------------------------------------------------------

def generateOddNumbers(n):
    result = []
    num = 1

    for i in range(n):
        result.append(num)
        num += 2

    return result


# ===== MAIN PROGRAM =====
n = int(input("Enter a number: "))

print("First", n, "odd numbers:", generateOddNumbers(n))
