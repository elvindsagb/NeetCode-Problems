Example

Input: 7
Output: Prime Number

----------------------------------------------------------------------------------------------------------------------

def isPrime(n):
    if n <= 1:
        return False
    
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    
    return True


# ===== MAIN PROGRAM =====
num = int(input("Enter a number: "))

if isPrime(num):
    print("Prime Number")
else:
    print("Not a Prime Number")
