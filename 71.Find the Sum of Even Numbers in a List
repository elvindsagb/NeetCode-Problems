Example

Input: 1 2 3 4 5 6
Output: 12

----------------------------------------------------------------------------------------------

def sumEven(nums):
    total = 0

    for num in nums:
        if num % 2 == 0:
            total += num

    return total


# ===== MAIN PROGRAM =====
nums = list(map(int, input("Enter numbers: ").split()))

print("Sum of even numbers:", sumEven(nums))
