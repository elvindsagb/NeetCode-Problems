def reverseEachWord(sentence):
    words = sentence.split()
    reversed_words = []

    for word in words:
        reversed_words.append(word[::-1])

    return " ".join(reversed_words)


# ===== MAIN PROGRAM =====
text = input("Enter a sentence: ")

print("Result:", reverseEachWord(text))
