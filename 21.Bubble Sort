Example

Input: 5 2 9 1 5 6
Output: 1 2 5 5 6 9

-------------------------------------------------------------------------------------------------------------------------

def bubbleSort(arr):
    n = len(arr)
    
    for i in range(n):
        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                # swap
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
    
    return arr


# ===== MAIN PROGRAM =====
nums = list(map(int, input("Enter numbers: ").split()))

sorted_nums = bubbleSort(nums)

print("Sorted array:", sorted_nums)
