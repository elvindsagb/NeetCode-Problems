def charFrequency(s):
    freq = {}

    for char in s:
        if char in freq:
            freq[char] += 1
        else:
            freq[char] = 1

    return freq


# ===== MAIN PROGRAM =====
text = input("Enter a string: ")

result = charFrequency(text)

for char, count in result.items():
    print(char, ":", count)
