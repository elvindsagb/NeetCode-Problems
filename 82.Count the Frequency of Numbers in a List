Example

Input: 1 2 2 3 1 4
Output:
1 → 2
2 → 2
3 → 1
4 → 1

-----------------------------------------------------------------------------------------------

def frequency(nums):
    freq = {}

    for num in nums:
        if num in freq:
            freq[num] += 1
        else:
            freq[num] = 1

    return freq


# ===== MAIN PROGRAM =====
nums = list(map(int, input("Enter numbers: ").split()))

result = frequency(nums)

for key, value in result.items():
    print(key, "->", value)
