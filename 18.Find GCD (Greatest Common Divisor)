Example

Input: 12 18
Output: 6

----------------------------------------------------------------------------------------------------------------------

def findGCD(a, b):
    while b:
        a, b = b, a % b
    return a


# ===== MAIN PROGRAM =====
num1 = int(input("Enter first number: "))
num2 = int(input("Enter second number: "))

print("GCD:", findGCD(num1, num2))
