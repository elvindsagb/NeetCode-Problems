Example:
Input: 1234
Output: 10

---------------------------------------------------------------------------

def sumOfDigits(n):
    total = 0
    
    while n > 0:
        total += n % 10
        n //= 10
    
    return total


# ===== MAIN PROGRAM =====
num = int(input("Enter a number: "))
print("Sum of digits:", sumOfDigits(num))
