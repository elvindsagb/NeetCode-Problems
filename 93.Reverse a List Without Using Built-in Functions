Example

Input: 1 2 3 4
Output: 4 3 2 1

-------------------------------------------

def reverseList(nums):
    reversed_list = []

    for i in range(len(nums) - 1, -1, -1):
        reversed_list.append(nums[i])

    return reversed_list


# ===== MAIN PROGRAM =====
nums = list(map(int, input("Enter numbers: ").split()))

print("Reversed list:", reverseList(nums))
