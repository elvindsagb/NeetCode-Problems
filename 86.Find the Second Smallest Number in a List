Example

Input: 8 3 10 2 5
Output: 3

---------------------------------------------------------------------------------

def secondSmallest(nums):
    nums = list(set(nums))  # remove duplicates
    nums.sort()

    if len(nums) < 2:
        return None

    return nums[1]


# ===== MAIN PROGRAM =====
nums = list(map(int, input("Enter numbers: ").split()))

result = secondSmallest(nums)

if result is None:
    print("No second smallest number")
else:
    print("Second smallest number:", result)
