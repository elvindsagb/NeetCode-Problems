Example:
Input: Madam
Output: Palindrome

-----------------------------------------------------------------------------------------------------

def isPalindromeString(s):
    cleaned = s.replace(" ", "").lower()
    return cleaned == cleaned[::-1]


# ===== MAIN PROGRAM =====
text = input("Enter a string: ")

if isPalindromeString(text):
    print("Palindrome")
else:
    print("Not a Palindrome")
