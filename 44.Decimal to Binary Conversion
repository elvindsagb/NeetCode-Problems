Input: 10
Output: 1010

---------------------------------------------------------------------------------------------------------------

def decimalToBinary(n):
    if n == 0:
        return "0"

    binary = ""

    while n > 0:
        binary = str(n % 2) + binary
        n //= 2

    return binary


# ===== MAIN PROGRAM =====
num = int(input("Enter a decimal number: "))
print("Binary representation:", decimalToBinary(num))
