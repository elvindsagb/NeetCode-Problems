Rule:

Divisible by 4

Not divisible by 100 unless also divisible by 400

--------------------------------------------------------------------------------------------------------------

def isLeapYear(year):
    if (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0):
        return True
    return False


# ===== MAIN PROGRAM =====
year = int(input("Enter year: "))

if isLeapYear(year):
    print("Leap Year")
else:
    print("Not a Leap Year")
