----------------------------------------------------------------------------------------------------------------

Example:
Input: 28
Output: Perfect Number

-----------------------------------------------------------------------------------------------------

def isPerfect(n):
    if n <= 1:
        return False
    
    divisor_sum = 0
    
    for i in range(1, n):
        if n % i == 0:
            divisor_sum += i
    
    return divisor_sum == n


# ===== MAIN PROGRAM =====
num = int(input("Enter a number: "))

if isPerfect(num):
    print("Perfect Number")
else:
    print("Not a Perfect Number")
