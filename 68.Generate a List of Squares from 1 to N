Example

Input: 5
Output: 1 4 9 16 25

------------------------------------------------------------------------------------

def generateSquares(n):
    squares = []

    for i in range(1, n + 1):
        squares.append(i * i)

    return squares


# ===== MAIN PROGRAM =====
n = int(input("Enter a number: "))

result = generateSquares(n)

print("Squares:", result)
