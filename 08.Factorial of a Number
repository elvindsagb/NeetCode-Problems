Example:

Input: 5
Output: 120

----------------------------------------------------------------------------------------------------------------------------------

def factorial(n):
    result = 1
    for i in range(1, n + 1):
        result *= i
    return result


# ===== MAIN PROGRAM =====
num = int(input("Enter a number: "))

if num < 0:
    print("Factorial not defined for negative numbers")
else:
    print("Factorial:", factorial(num))
