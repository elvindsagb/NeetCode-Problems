Example

Input: 121
Output: Palindrome

------------------------------------------------------------------------------------------------------

def isPalindrome(num):
    original = num
    reversed_num = 0

    while num > 0:
        digit = num % 10
        reversed_num = reversed_num * 10 + digit
        num //= 10

    return original == reversed_num


# ===== MAIN PROGRAM =====
num = int(input("Enter a number: "))

if isPalindrome(num):
    print("Palindrome number")
else:
    print("Not a palindrome number")
