Example

Input: 30
Output: 7 14 21 28

-------------------------------------------------------------------------------------------------------------

def divisibleBy7(n):
    result = []

    for i in range(1, n + 1):
        if i % 7 == 0:
            result.append(i)

    return result


# ===== MAIN PROGRAM =====
n = int(input("Enter a number: "))

print("Numbers divisible by 7:", divisibleBy7(n))
