Example

Input: 12
Output: 1 2 3 4 6 12


-----------------------------------------------------------------------------------------------------

def printFactors(n):
    factors = []
    for i in range(1, n + 1):
        if n % i == 0:
            factors.append(i)
    return factors


# ===== MAIN PROGRAM =====
num = int(input("Enter a number: "))

result = printFactors(num)

print("Factors:", result)
